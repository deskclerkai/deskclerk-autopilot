# Copy to .env and change every value before exposing the app.

# Required in production. Generate one with:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
APP_SECRET=please-change-to-a-long-random-string
APP_ENV=production

# Empty database + no demo accounts on first boot.
DEMO_SEED=0
DB_PATH=/data/app.db

# Restrict browser origins in production, for example:
# ALLOWED_ORIGINS=https://desk.example.com
ALLOWED_ORIGINS=*

# WhatsApp Cloud API (filled in through the UI as well)
WA_APP_SECRET=

# Optional: supply the knowledge-base key through the environment.
# Base URL and site ID are set in the app UI.
AICHAT_KEY=
